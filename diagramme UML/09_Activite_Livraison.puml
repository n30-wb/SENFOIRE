@startuml
' ===== DIAGRAMME D'ACTIVITÉ 3 : Processus de Livraison =====
' Plateforme SENFOIRE - Foire Internationale Virtuelle

skinparam activity {
  BackgroundColor #FFF3E0
  BorderColor #FB8C00
  FontSize 12
}
skinparam activityDiamond {
  BackgroundColor #FFF9C4
  BorderColor #F9A825
  FontSize 11
}
skinparam swimlane {
  BackgroundColor #F5F5F5
  BorderColor #90A4AE
  FontSize 13
}
skinparam arrow {
  Color #455A64
  FontSize 11
}

|Caissier|
start
:Consulter les commandes\nen attente de validation;
:Ouvrir une commande;
:Vérifier les détails\n(montant, articles,\nréduction, paiement);

if (Paiement\nconfirmé ?) then (oui)
  :Valider le paiement;
  :Mettre à jour\nstatut commande → payée;

  |Système|
  :Créer l'enregistrement\nde livraison\n(statut: disponible);
  :Calculer le prix de livraison\n(formule Haversine);
  :Notifier tous les livreurs\ndisponibles;
  :Notifier le client\n(paiement confirmé);

  |Livreur|
  :Recevoir la notification\nde livraison disponible;
  :Consulter les livraisons\ndisponibles;

  if (Disponible\npour livrer ?) then (oui)
    :Consulter les détails\n(client, articles, distance);
    :Accepter la livraison;
    :Mettre à jour\nstatut → prise_en_charge;

    |Système|
    :Mettre à jour\nstatut commande\n→ en_cours_livraison;
    :Notifier le client\n(livreur assigné);

    |Client|
    :Recevoir la notification\nde livreur assigné;
    :Suivre le livreur\nen temps réel (GPS);

    |Livreur|
    :Se rendre chez\nle client;

    |Système|
    :Recevoir les mises à jour\nGPS du livreur;
    :Diffuser la position\nau client (WebSocket);

    |Livreur|
    :Arriver chez\nle client;
    :Remettre le colis;
    :Confirmer la livraison;
    :Mettre à jour\nstatut → livrée;

    |Système|
    :Mettre à jour\nstatut commande\n→ livrée;
    :Créditer +10 points\nlivreur;
    :Notifier le client\n(colis livré);

    |Client|
    :Recevoir la livraison;

    if (Satisfait du\nservice ?) then (oui)
      :Noter la livraison\n(1-5 étoiles);
      :Laisser un commentaire;
    else (non)
      :Demander un retour\nou remboursement;
    endif

    |Administrateur|
    if (Demande de\nretour ?) then (oui)
      :Examiner la demande;
      :Prendre une décision\n(approuver/refuser/rembourser);
      :Notifier le client;
    else (non)
    endif

  else (non - indisponible)
    :Aucune action;
    stop
  endif
else (non)
  |Système|
  :Notifier l'échec\nau client;
  :Mettre à jour\nstatut → annulée;
endif

stop

@enduml

@startuml
' ===== DIAGRAMME D'ACTIVITÉ 1 : Passer une commande =====
' Plateforme SENFOIRE - Foire Internationale Virtuelle

skinparam activity {
  BackgroundColor #E8F5E9
  BorderColor #43A047
  FontSize 12
}
skinparam activityDiamond {
  BackgroundColor #FFF9C4
  BorderColor #F9A825
  FontSize 11
}
skinparam swimlane {
  BackgroundColor #F5F5F5
  BorderColor #90A4AE
  FontSize 13
}
skinparam arrow {
  Color #455A64
  FontSize 11
}

|Client|
start
:Accéder au\ncatalogue produits;
:Consulter le catalogue\nou rechercher un produit;
:Choisir un produit;
:Voir les détails\ndu produit;

if (Souhaite\najouter au panier ?) then (oui)
  :Ajouter au panier;
  if (Continuer\nles achats ?) then (oui)
    :Retour au catalogue;
    detach
  else (non)
  endif
else (non)
  :Retour au catalogue;
  detach
endif

:Consulter le panier;
:Vérifier les articles\net quantités;

if (Avoir un\ncode promo ?) then (oui)
  :Saisir le code promo;
  :Valider le code promo;
  if (Code valide ?) then (oui)
    :Réduction appliquée;
  else (non)
    :Afficher erreur;
    :Ignorer le code;
  endif
else (non)
endif

if (Avoir des\npoints fidélité ?) then (oui)
  :Saisir le nombre\nde points à utiliser;
  :Calculer la réduction\n(1 pt = 10 FCFA);
else (non)
endif

:Choisir le mode de paiement\n(Wave / Orange Money / Espèces);
:Confirmer la commande;

|Système|
:Vérifier la disponibilité\ndes stocks;

if (Stocks\nsuffisants ?) then (oui)
  :Décrémenter les stocks;
  :Créer la commande\n(statut: en_attente);
  :Créer les lignes de commande;
  :Appliquer la réduction\nfidélité si applicable;
  :Créer le paiement\n(statut: initie);
  :Calculer le prix de livraison\n(service Haversine);
  :Notifier le client\n+ tous les caissiers;
  :Attribuer les points\nfidélité (+1 point/1000 FCFA);

  |Caissier|
  :Voir la commande\nen attente;
  :Vérifier les détails\n(montant, réduction, articles);

  if (Valide le\npaiement ?) then (oui)
    :Confirmer le paiement\n(statut: payée);
    :Créer la livraison\n(statut: disponible);

    |Système|
    :Notifier les livreurs\ndisponibles;
    :Notifier le client;

    |Livreur|
    :Voir les livraisons\ndisponibles;
    :Accepter la livraison;
    :Livrer le colis;

    |Système|
    :Mettre à jour\nles statuts;

    |Client|
    :Recevoir la livraison;
    if (Satisfait ?) then (oui)
      :Noter la livraison\n(1 à 5 étoiles);
    else (non)
      :Demander un retour;
    endif
  else (non)
    |Système|
    :Notifier l'échec\nau client;
  endif
else (non)
  |Système|
  :Signaler rupture\nde stock;

  |Client|
  :Recevoir l'alerte;
endif

stop

@enduml
